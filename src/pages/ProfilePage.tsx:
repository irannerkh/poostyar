import React from 'react';
import { Link, Navigate } from 'react-router-dom';
import { useStore } from '../context/StoreContext';
import { PRODUCTS } from '../data/products';

export const ProfilePage: React.FC = () => {
  const { user, logoutUser, wishlist } = useStore();
  if (!user) return <Navigate to="/auth" replace />;

  const favProducts = PRODUCTS.filter((p) => wishlist.includes(p.id));

  return (
    <div className="mx-auto max-w-5xl px-4 py-10 sm:px-6">
      <div className="flex flex-wrap items-center justify-between gap-4 rounded-3xl border border-[#F0DCE3] bg-white p-6 shadow-soft">
        <div>
          <h1 className="text-xl font-black text-[#6D1344]">سلام، {user.name}</h1>
          <p className="mt-1 text-xs text-[#6F4C5D]">
            {user.email} • {user.phone}
          </p>
        </div>
        <button
          type="button"
          onClick={logoutUser}
          className="rounded-full border border-rose-300 px-5 py-2 text-xs font-bold text-rose-700 hover:bg-rose-50"
        >
          خروج از حساب
        </button>
      </div>

      <div className="mt-8 rounded-3xl border border-[#F0DCE3] bg-white p-6 shadow-soft">
        <h2 className="text-base font-black text-[#2B1220]">
          محصولات موردعلاقه شما ({favProducts.length})
        </h2>
        {favProducts.length === 0 ? (
          <p className="mt-3 text-xs text-[#6F4C5D]">هنوز محصولی به علاقه‌مندی‌ها اضافه نکرده‌اید.</p>
        ) : (
          <div className="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {favProducts.map((p) => (
              <Link
                key={p.id}
                to={`/product/${p.id}`}
                className="flex items-center gap-3 rounded-2xl border border-[#F3E2E8] p-3 hover:bg-[#FDF8F6]"
              >
                <img src={p.image} alt={p.name} className="h-14 w-14 rounded-xl object-cover" />
                <div>
                  <h3 className="text-xs font-extrabold text-[#2B1220]">{p.name}</h3>
                  <p className="text-xs font-bold text-[#6D1344]">
                    {(p.discountPrice ?? p.price).toLocaleString('fa-IR')} تومان
                  </p>
                </div>
              </Link>
            ))}
          </div>
        )}
      </div>
    </div>
  );
};
